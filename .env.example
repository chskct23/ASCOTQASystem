# Port for local server (defaults to 3000)
PORT=3000

# Gemini API Key for executive feasibility report generation
GEMINI_API_KEY=your-gemini-api-key

# Supabase Cloud PostgreSQL Database (Free Tier on https://supabase.com)
# When configured, survey responses are stored in Supabase PostgreSQL (zero data loss on Vercel)
# If unconfigured or offline, the system automatically falls back to local JSON storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key